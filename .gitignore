# Minecraft instances generate runtime files constantly (caches, logs,
# per-mod data folders). Ignore everything by default and explicitly
# whitelist only the files that define the pack.
/*

# --- Tracked: pack definition ---
!/.gitignore
!/.gitattributes
# Loaded automatically at the start of every Claude Code session
!/CLAUDE.md
!/.github/
!/.vscode/
!/config/
!/defaultconfigs/
!/datapacks/
!/kubejs/
!/minecraftinstance.json

# Pack content for clone-and-play on another computer
# (mods/Cobblemon*.jar is stored via Git LFS — over GitHub's 100MB limit)
!/mods/
!/resourcepacks/
!/shaderpacks/

# Personal-but-worth-backing-up settings (remove if you don't want them)
!/options.txt
!/emi.json

# Pack documentation: beneficial-effect reference, EMI biome thumbnail
# worklist and its 4x sprite previews / reference screenshots
!/chunkbound_info/
# Full-res screenshot originals stay local; the 240px copies in shots/ are
# what the doc embeds and what gets committed.
chunkbound_info/biome-sprites/screenshots/
chunkbound_info/tools/__pycache__/

# --- Runtime junk inside tracked folders ---
kubejs/exported/
kubejs/logs/
# Generated blob containing a local web-editor password
config/resourceful-config-web.json

# Per-mod config that mods rewrite on every launch (defaults filled in,
# options resaved) — pure noise, not intentional pack tuning.
config/NoChatReports/
config/attributefix/
config/bettercombat/
config/bountiful/errors.log
config/euphoria_patcher/
config/fabric/
config/xaero/
config/betterfpsdist.json
config/capture_xp.json
config/catchrate-display.json
config/chat_heads.json5
config/chunksending.json
config/continuity.json
config/cubes_without_borders.json
config/emi_ores-client.json
config/entity_model_features.json
config/entity_texture_features.json
config/etf_warnings.json
config/flerovium.json
config/fml.toml
config/ftbchunks-client.snbt
config/immediatelyfast.json
config/immersive_optimization.json
config/immersiveui.yaml
config/iris.properties
config/lithostitched.json
config/modernfix-mixins.properties
config/runiclib.json
config/simpletms/main.json
config/sodium-options.json
config/spawn_notification.json
config/structure_layout_optimizer.jsonc
config/tim_core.json

# KubeJS's own regenerated runtime settings (not scripts/data)
kubejs/config/

# ProbeJS-generated autocomplete snippets (huge, regenerated on reload)
.vscode/probejs.code-snippets

# Per-shaderpack option state saved next to the pack
shaderpacks/*.txt

# spark's own scratch space (it documents these as temporary data)
config/spark/tmp/
config/spark/tmp-client/

# Config-library backups written next to the file they back up
config/*.toml.bak
