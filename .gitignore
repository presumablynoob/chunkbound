# Minecraft instances generate runtime files constantly (caches, logs,
# per-mod data folders). Ignore everything by default and explicitly
# whitelist only the files that define the pack.
/*

# --- Tracked: pack definition ---
!/.gitignore
!/.gitattributes
!/.github/
!/.vscode/
!/config/
!/defaultconfigs/
!/datapacks/
!/kubejs/
!/minecraftinstance.json

# Pack content for clone-and-play on another computer
# (mods/Cobblemon*.jar is stored via Git LFS — over GitHub's 100MB limit)
!/mods/
!/resourcepacks/
!/shaderpacks/

# Personal-but-worth-backing-up settings (remove if you don't want them)
!/options.txt
!/emi.json

# --- Runtime junk inside tracked folders ---
kubejs/exported/
kubejs/logs/
# Generated blob containing a local web-editor password
config/resourceful-config-web.json
